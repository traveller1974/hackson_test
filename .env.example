# 复制为 .env 后填写。全部留空则进入纯本地演示模式（mock 数据 + 规则引擎）。

# ---- PayPal 沙盒（必填其一才能调用真实 PayPal API）----
# 在 https://developer.paypal.com 创建 Sandbox App 后获取
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---- 大模型（可选，OpenAI 兼容接口；留空则用内置规则引擎）----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
